[Unit]
Description=Kakao message collector and text sender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kakao-rust
Group=kakao-rust
StateDirectory=kakao-rust
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/kakao-rust --data-dir /var/lib/kakao-rust native run
Restart=on-abnormal
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kakao-rust
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
